{
  "contributes": [
    {
      "bin": "claude",
      "capabilities": [
        "web_search"
      ],
      "install_hints": {
        "brew-cask": "claude-code"
      },
      "kind": "program",
      "protocols": [
        "anthropic"
      ],
      "update": [
        "install"
      ],
      "url": "https://claude.ai/install.sh",
      "via": "installer"
    },
    {
      "from": "loopholes/claude-oauth-broker",
      "kind": "loophole"
    },
    {
      "after": "host:.claude/CLAUDE.md",
      "agent": "claude",
      "into": ".claude/CLAUDE.md",
      "kind": "briefing"
    },
    {
      "agent": "claude",
      "into": ".claude/skills",
      "kind": "skills",
      "reserved": ["synced"]
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "defaults": {
            "projects": {
              "${workspace}": {
                "hasTrustDialogAccepted": true
              }
            }
          },
          "managed": {
            "projects": {
              "${workspace}": {
                "enableAllProjectMcpServers": true
              }
            }
          },
          "mode": "rmw",
          "name": "config",
          "path": "~/.claude.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "defaults": {
            "statusLine": {
              "command": "yolo internal footer --agent claude --login 'Claude subscription' --truthy 1,true,yes,on --switch CLAUDE_CODE_USE_BEDROCK=bedrock --switch CLAUDE_CODE_USE_FOUNDRY=foundry --switch CLAUDE_CODE_USE_ANTHROPIC_AWS=anthropic-aws --switch CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD=anthropic-google-cloud --switch CLAUDE_CODE_USE_MANTLE=mantle --switch CLAUDE_CODE_USE_VERTEX=vertex --words bedrock=Bedrock --words 'openai-codex=ChatGPT subscription' --words 'foundry=Microsoft Foundry' --words 'anthropic-aws=Claude Platform on AWS' --words 'anthropic-google-cloud=Claude Platform on Google Cloud' --words 'mantle=Bedrock Mantle' --words 'vertex=Vertex AI' --bridged openai-codex --bridged cerebras --bridged kilo --template '{stdin.model.display_name} · yolo: {yolo.billing} · {yolo.notch}'",
              "type": "command"
            }
          },
          "name": "settings",
          "path": "~/.claude/settings.json",
          "readsHost": true,
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "claude",
            "codec": "json",
            "managed": {
              "permissions": {
                "additionalDirectories": [
                  "/"
                ],
                "allow": [],
                "defaultMode": "acceptEdits",
                "deny": []
              },
              "skipDangerousModePermissionPrompt": true
            },
            "name": "settings",
            "path": "~/.claude/settings.json"
          }
        ],
        "launch": [
          {
            "bin": "claude",
            "flags": [
              "--dangerously-skip-permissions"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "claude",
            "codec": "json",
            "managed": {
              "permissions": {
                "additionalDirectories": [],
                "defaultMode": "default"
              },
              "skipDangerousModePermissionPrompt": false
            },
            "name": "settings",
            "path": "~/.claude/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "kind": "provider",
      "name": "bedrock"
    },
    {
      "kind": "profile",
      "name": "bedrock",
      "provider": "bedrock"
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "kind": "env",
      "profile": "bedrock",
      "vars": {
        "CLAUDE_CODE_USE_BEDROCK": "1"
      }
    },
    {
      "config": {
        "managed": {
          "env": {
            "CLAUDE_CODE_USE_BEDROCK": "1"
          }
        }
      },
      "kind": "config-overlay",
      "profile": "bedrock",
      "surface": "claude/settings"
    },
    {
      "at": ".claude",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".claude-shared-credentials",
      "because": "identity/credential state shared across workspaces",
      "kind": "state",
      "scope": "machine"
    },
    {
      "at": ".claude-shared-credentials",
      "from": ".claude/.credentials.json",
      "hook": "shared_credentials",
      "kind": "hook"
    },
    {
      "from": ".claude/history.jsonl",
      "hook": "per_jail_history",
      "kind": "hook"
    }
  ],
  "name": "claude",
  "needs": [
    {
      "pack": "aws-auth"
    },
    {
      "pack": "openai-auth"
    },
    {
      "pack": "wire-bridge"
    }
  ],
  "skills_tier": "namespaced"
}
