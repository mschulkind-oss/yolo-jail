{
  "contributes": [
    {
      "bin": "claude",
      "install_hints": {
        "brew-cask": "claude-code"
      },
      "kind": "program",
      "url": "https://claude.ai/install.sh",
      "via": "installer"
    },
    {
      "from": "loopholes/claude-oauth-broker",
      "kind": "loophole"
    },
    {
      "after": "host:.claude/CLAUDE.md",
      "into": ".claude/CLAUDE.md",
      "kind": "briefing"
    },
    {
      "into": ".claude/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "defaults": {
            "projects": {
              "${workspace}": {
                "hasTrustDialogAccepted": true
              }
            }
          },
          "managed": {
            "projects": {
              "${workspace}": {
                "enableAllProjectMcpServers": true
              }
            }
          },
          "mode": "rmw",
          "name": "config",
          "path": "~/.claude.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "managed": {
            "preferences": {
              "autoUpdaterStatus": "disabled"
            }
          },
          "name": "settings",
          "path": "~/.claude/settings.json",
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "claude",
            "codec": "json",
            "managed": {
              "permissions": {
                "additionalDirectories": [
                  "/"
                ],
                "allow": [],
                "defaultMode": "acceptEdits",
                "deny": []
              },
              "skipDangerousModePermissionPrompt": true
            },
            "name": "settings",
            "path": "~/.claude/settings.json"
          }
        ],
        "launch": [
          {
            "bin": "claude",
            "flags": [
              "--dangerously-skip-permissions"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "claude",
            "codec": "json",
            "managed": {
              "permissions": {
                "additionalDirectories": [],
                "defaultMode": "default"
              },
              "skipDangerousModePermissionPrompt": false
            },
            "name": "settings",
            "path": "~/.claude/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "kind": "provider",
      "name": "bedrock"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "managed": {
            "env": {
              "CLAUDE_CODE_USE_BEDROCK": "1"
            }
          },
          "name": "settings",
          "path": "~/.claude/settings.json"
        }
      ],
      "env": {
        "CLAUDE_CODE_USE_BEDROCK": "1"
      },
      "kind": "profile",
      "name": "bedrock",
      "requires_provider": "bedrock"
    },
    {
      "at": ".claude",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".claude-shared-credentials",
      "because": "identity/credential state shared across workspaces",
      "kind": "state",
      "scope": "machine"
    },
    {
      "host": ".claude/settings.json",
      "into": "host-claude/settings.json",
      "kind": "reads-host"
    },
    {
      "at": ".claude-shared-credentials",
      "from": ".claude/.credentials.json",
      "hook": "shared_credentials",
      "kind": "hook"
    },
    {
      "from": ".claude/history.jsonl",
      "hook": "per_jail_history",
      "kind": "hook"
    },
    {
      "hook": "claude_plugins",
      "kind": "hook"
    }
  ],
  "name": "claude",
  "skills_tier": "namespaced"
}
