{
  "contributes": [
    {
      "bin": "claude",
      "kind": "program",
      "url": "https://claude.ai/install.sh",
      "via": "installer"
    },
    {
      "after": "host:.claude/CLAUDE.md",
      "from": "AGENTS.md",
      "into": ".claude/CLAUDE.md",
      "kind": "briefing"
    },
    {
      "from": "skills",
      "into": ".claude/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "defaults": {
            "projects": {
              "${workspace}": {
                "hasTrustDialogAccepted": true
              }
            }
          },
          "managed": {
            "projects": {
              "${workspace}": {
                "enableAllProjectMcpServers": true
              }
            }
          },
          "mode": "rmw",
          "name": "config",
          "path": "~/.claude.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "claude",
          "codec": "json",
          "managed": {
            "permissions": {
              "additionalDirectories": [
                "/"
              ],
              "allow": [],
              "defaultMode": "acceptEdits",
              "deny": []
            },
            "preferences": {
              "autoUpdaterStatus": "disabled"
            },
            "skipDangerousModePermissionPrompt": true
          },
          "name": "settings",
          "path": "~/.claude/settings.json",
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "at": ".claude",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".claude-shared-credentials",
      "because": "identity/credential state shared across workspaces",
      "kind": "state",
      "scope": "machine"
    },
    {
      "host": ".claude/settings.json",
      "into": "host-claude/settings.json",
      "kind": "reads-host"
    },
    {
      "bin": "claude",
      "flags": [
        "--dangerously-skip-permissions"
      ],
      "kind": "launch"
    },
    {
      "at": ".claude-shared-credentials",
      "from": ".claude/.credentials.json",
      "hook": "shared_credentials",
      "kind": "hook"
    },
    {
      "from": ".claude/history.jsonl",
      "hook": "per_jail_history",
      "kind": "hook"
    },
    {
      "hook": "claude_plugins",
      "kind": "hook"
    }
  ],
  "name": "claude",
  "retireMiseTools": [
    "\"npm:@anthropic-ai/claude-code\""
  ]
}
