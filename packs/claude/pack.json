{
  "hooks": [
    {
      "file": ".claude/.credentials.json",
      "name": "shared_credentials",
      "sharedDir": ".claude-shared-credentials"
    },
    {
      "file": ".claude/history.jsonl",
      "name": "per_jail_history"
    },
    {
      "name": "claude_plugins"
    }
  ],
  "hostFiles": [
    {
      "from": ".claude/settings.json",
      "to": "host-claude/settings.json"
    }
  ],
  "install": {
    "bin": "claude",
    "installerUrl": "https://claude.ai/install.sh",
    "kind": "native"
  },
  "launchFlags": {
    "claude": [
      "--dangerously-skip-permissions"
    ]
  },
  "mounts": [
    {
      "from": "AGENTS.md",
      "hostOverlay": ".claude/CLAUDE.md",
      "to": ".claude/CLAUDE.md"
    },
    {
      "from": "skills",
      "to": ".claude/skills"
    }
  ],
  "name": "claude",
  "retireMiseTools": [
    "\"npm:@anthropic-ai/claude-code\""
  ],
  "sharedDirs": [
    ".claude-shared-credentials"
  ],
  "surfaces": [
    {
      "agent": "claude",
      "codec": "json",
      "computed": [
        {
          "from": "mcp_servers",
          "reconcile": true,
          "to": "mcpServers"
        }
      ],
      "defaults": {
        "projects": {
          "${workspace}": {
            "hasTrustDialogAccepted": true
          }
        }
      },
      "managed": {
        "projects": {
          "${workspace}": {
            "enableAllProjectMcpServers": true
          }
        }
      },
      "mode": "rmw",
      "name": "config",
      "path": "~/.claude.json"
    },
    {
      "agent": "claude",
      "codec": "json",
      "computed": [
        {
          "to": "mcpServers",
          "tombstone": true
        },
        {
          "flags": [
            {
              "key": "pyright-lsp@claude-plugins-official",
              "value": true,
              "whenPresent": "python"
            },
            {
              "key": "typescript-lsp@claude-plugins-official",
              "value": true,
              "whenPresent": "typescript"
            },
            {
              "key": "gopls-lsp@claude-plugins-official",
              "value": true,
              "whenPresent": "go"
            }
          ],
          "from": "lsp_servers",
          "to": "enabledPlugins"
        },
        {
          "flags": [
            {
              "key": "ENABLE_LSP_TOOL",
              "value": "1",
              "whenAny": true
            }
          ],
          "from": "lsp_servers",
          "to": "env"
        }
      ],
      "managed": {
        "permissions": {
          "additionalDirectories": [
            "/"
          ],
          "allow": [],
          "defaultMode": "acceptEdits",
          "deny": []
        },
        "preferences": {
          "autoUpdaterStatus": "disabled"
        },
        "skipDangerousModePermissionPrompt": true
      },
      "name": "settings",
      "path": "~/.claude/settings.json",
      "retireOnFirstRender": [
        "yolo-host-synced-settings.json"
      ]
    }
  ],
  "writableDirs": [
    ".claude"
  ]
}
