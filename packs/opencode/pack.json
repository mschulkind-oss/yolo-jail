{
  "contributes": [
    {
      "bin": "opencode",
      "install_hints": {
        "brew": "opencode",
        "pacman": "opencode"
      },
      "kind": "program",
      "package": "opencode-ai",
      "protocols": [
        "openai"
      ],
      "via": "npm"
    },
    {
      "after": "host:.config/opencode/AGENTS.md",
      "agent": "opencode",
      "into": ".config/opencode/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "opencode",
      "into": ".config/opencode/skills",
      "kind": "skills"
    },
    {
      "from": "footer/yolo-footer.js",
      "into": ".config/opencode/yolo/footer.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "opencode",
          "codec": "json",
          "defaults": {
            "$schema": "https://opencode.ai/config.json"
          },
          "name": "config",
          "path": "~/.config/opencode/opencode.json",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        },
        {
          "agent": "opencode",
          "codec": "json",
          "defaults": {
            "plugin": [
              "./yolo/footer.js"
            ]
          },
          "name": "tui",
          "path": "~/.config/opencode/tui.jsonc"
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "opencode",
            "codec": "json",
            "managed": {
              "permission": "allow"
            },
            "name": "config",
            "path": "~/.config/opencode/opencode.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "opencode",
            "codec": "json",
            "managed": {
              "permission": {
                "bash": "ask",
                "edit": "ask"
              }
            },
            "name": "config",
            "path": "~/.config/opencode/opencode.json"
          }
        ]
      },
      "kind": "autonomy"
    }
  ],
  "name": "opencode"
}
