{
  "contributes": [
    {
      "bin": "opencode",
      "kind": "program",
      "package": "opencode-ai",
      "via": "npm"
    },
    {
      "after": "host:.config/opencode/AGENTS.md",
      "from": "AGENTS.md",
      "into": ".config/opencode/AGENTS.md",
      "kind": "briefing"
    },
    {
      "config": [
        {
          "agent": "opencode",
          "codec": "json",
          "defaults": {
            "$schema": "https://opencode.ai/config.json"
          },
          "managed": {
            "permission": "allow"
          },
          "name": "config",
          "path": "~/.config/opencode/opencode.json",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        }
      ],
      "kind": "config"
    }
  ],
  "name": "opencode"
}
