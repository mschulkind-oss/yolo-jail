{
  "contributes": [
    // Where each install hint's name came from, one line per manager, checked 2026-10-02.
    //   brew: https://formulae.brew.sh/api/formula/opencode.json (bin/opencode in its formula source)
    //   pacman: https://archlinux.org/packages/extra/x86_64/opencode/files/ (usr/bin/opencode)
    {
      "bin": "opencode",
      "exact_menu_refuses": {
        "providers": [
          "openai-codex"
        ]
      },
      "install_hints": {
        "brew": "opencode",
        "pacman": "opencode"
      },
      "kind": "program",
      // How `yolo host -p <profile> -- opencode` moves opencode for one launch without touching
      // ~/.config/opencode/opencode.json (docs/design/model-lists-and-pickers.md MM-D30): the
      // config derive's selection (model, small_model, enabled_providers) and the provider rows
      // enabled_providers names, as one JSON document in OPENCODE_CONFIG_CONTENT, which opencode
      // merges over its config files (MEASURED on opencode 1.18.34 for model and small_model).
      "launch_selection": {
        "env": "OPENCODE_CONFIG_CONTENT",
        "rows": {
          "named_by": [
            "enabled_providers"
          ],
          "table": "provider"
        },
        "surface": ".config/opencode/opencode.json"
      },
      "package": "opencode-ai",
      "platform_regions": [
        {
          "platform": "aws-bedrock",
          "region_env_name": [
            "AWS_REGION"
          ]
        }
      ],
      // A version probe answers at once (pi-extension-store-builds.md XB-D24, XB-D51): the
      // word the per-pack install matrix runs (integration/agents_test.go).
      "probe_args": [
        "--version"
      ],
      "protocols": [
        "openai",
        "openai-responses"
      ],
      "provider_sets": true,
      "via": "npm"
    },
    {
      "after": "host:.config/opencode/AGENTS.md",
      "agent": "opencode",
      "into": ".config/opencode/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "opencode",
      "into": ".config/opencode/skills",
      "kind": "skills",
      "project_dirs": [".opencode/skills", ".claude/skills", ".agents/skills"]
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "from": "footer/yolo-footer.js",
      "into": ".config/opencode/yolo/footer.js",
      "kind": "files"
    },
    {
      "from": "plugins/yolo-openai-auth.js",
      "into": ".config/opencode/plugins/yolo-openai-auth.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "opencode",
          "codec": "json",
          "defaults": {
            "$schema": "https://opencode.ai/config.json"
          },
          "name": "config",
          "path": "~/.config/opencode/opencode.json",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        },
        {
          "agent": "opencode",
          "codec": "json",
          "defaults": {
            "plugin": [
              "./yolo/footer.js"
            ]
          },
          "name": "tui",
          "path": "~/.config/opencode/tui.jsonc"
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "opencode",
            "codec": "json",
            "managed": {
              "permission": "allow"
            },
            "name": "config",
            "path": "~/.config/opencode/opencode.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "opencode",
            "codec": "json",
            "managed": {
              "permission": {
                "bash": "ask",
                "edit": "ask"
              }
            },
            "name": "config",
            "path": "~/.config/opencode/opencode.json"
          }
        ]
      },
      "kind": "autonomy"
    }
  ],
  "name": "opencode",
  "needs": [
    {
      "pack": "bedrock"
    },
    {
      "pack": "openai-auth"
    }
  ]
}
