{
  "install": {
    "bin": "opencode",
    "kind": "npm",
    "package": "opencode-ai"
  },
  "mounts": [
    {
      "from": "AGENTS.md",
      "hostOverlay": ".config/opencode/AGENTS.md",
      "to": ".config/opencode/AGENTS.md"
    }
  ],
  "name": "opencode",
  "surfaces": [
    {
      "agent": "opencode",
      "codec": "json",
      "computed": [
        {
          "from": "mcp_servers",
          "omitEmpty": true,
          "project": {
            "ops": [
              {
                "fold": {
                  "froms": [
                    "command",
                    "args"
                  ],
                  "to": "command"
                }
              },
              {
                "copy": {
                  "from": "env",
                  "omitEmpty": true,
                  "to": "environment"
                }
              },
              {
                "inject": {
                  "to": "type",
                  "value": "local"
                }
              },
              {
                "inject": {
                  "to": "enabled",
                  "value": true
                }
              }
            ]
          },
          "to": "mcp"
        }
      ],
      "defaults": {
        "$schema": "https://opencode.ai/config.json"
      },
      "managed": {
        "permission": "allow"
      },
      "name": "config",
      "path": "~/.config/opencode/opencode.json",
      "retireOnFirstRender": [
        "yolo-managed-mcp-servers.json"
      ]
    }
  ]
}
