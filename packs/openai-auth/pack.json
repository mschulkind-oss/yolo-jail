{
  "contributes": [
    {
      "from": "loopholes/openai-auth-broker",
      "kind": "loophole"
    },
    {
      "capabilities": [
        "web_search"
      ],
      "endpoints": {
        "openai-responses": {
          "base_url": "https://chatgpt.com/backend-api/codex",
          "wire_api": "openai-responses"
        }
      },
      "kind": "provider",
      "name": "openai-codex"
    }
  ],
  "description": "One machine-wide owner for OpenAI subscription login and refresh-token rotation.",
  "name": "openai-auth"
}
