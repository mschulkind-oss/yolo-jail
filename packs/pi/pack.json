{
  "contributes": [
    // Where each install hint's name came from, one line per manager, checked 2026-10-02.
    //   brew: https://formulae.brew.sh/api/formula/pi-coding-agent.json (bin/pi in its formula source)
    //   dnf: https://packages.fedoraproject.org/pkgs/pi-coding-agent/pi-coding-agent/fedora-rawhide.html#files (/usr/bin/pi; only in Fedora 45, unreleased on 2026-10-02, and Rawhide, so dnf finds no such package on Fedora 43 or 44)
    {
      "bin": "pi",
      // pi's own providers, read from pi 1.0.1's installed code on 2026-10-05, never run: the ids
      // pi-ai's builtinProviders() registers (dist/providers/all.js) and the `llama.cpp` its own
      // extension adds (dist/extensions/llama/provider.js). yolo writes no model entry over one
      // (docs/design/pi-codex-provider-shadowing.md OQ-3). pi's own zai already calls the coding
      // plan (api.z.ai/api/coding/paas/v4, reading ZAI_API_KEY), so yolo's zai needs no plan.
      "built_in_providers": {
        "names": [
          "amazon-bedrock", "ant-ling", "anthropic", "azure-openai-responses", "baseten",
          "cerebras", "cloudflare-ai-gateway", "cloudflare-workers-ai", "deepseek", "fireworks",
          "github-copilot", "google", "google-vertex", "groq", "huggingface", "kimi-coding",
          "llama.cpp", "meta", "minimax", "minimax-cn", "mistral", "moonshotai", "moonshotai-cn",
          "nvidia", "openai", "openai-codex", "opencode", "opencode-go", "openrouter",
          "qwen-token-plan", "qwen-token-plan-cn", "qwen-token-plan-individual", "radius",
          "together", "typesafe", "vercel-ai-gateway", "xai", "xiaomi", "xiaomi-token-plan-ams",
          "xiaomi-token-plan-cn", "xiaomi-token-plan-sgp", "zai", "zai-coding-cn"
        ],
        // openai-codex runs on pi's own client but on yolo's list: extensions/yolo-openai-auth.js
        // registers the one list packs/openai-auth declares (model-lists-and-pickers.md ML-D1).
        "yolo_lists": ["openai-codex"]
      },
      "flags": [
        "--ignore-scripts"
      ],
      "install_hints": {
        "brew": "pi-coding-agent",
        "dnf": "pi-coding-agent"
      },
      "kind": "program",
      // the settings derive's selection as pi's own flags: --provider qualifies --model and
      // --models replaces enabledModels (measured in pi 1.0.4's installed source); the provider
      // flag is emitted only when defaultModel is present, because pi rejects an orphan provider.
      // Explicit model selections retain provider qualification, including for overlapping model
      // ids. The two model-list files pi's extensions read are handed in their declared variables
      // before the files (extensions/yolo-openai-auth.js, extensions/yolo-model-lists.js).
      // None of it goes in front of a subcommand: pi reads one only as its first word, so
      // `pi --provider zai update` would start a session whose first prompt is "update".
      "launch_selection": {
        "flags": [
          {
            "argv": [
              "--provider",
              "{value}"
            ],
            "key": "defaultProvider",
            "requires": ["defaultModel"]
          },
          {
            "argv": [
              "--model",
              "{value}"
            ],
            "key": "defaultModel"
          },
          {
            "argv": [
              "--models",
              "{value}"
            ],
            "key": "enabledModels"
          }
        ],
        "subcommands": [
          "auth",
          "config",
          "install",
          "list",
          "mcp",
          "remove",
          "uninstall",
          "update"
        ],
        "surface": ".pi/agent/settings.json",
        "surfaces": {
          ".pi/agent/yolo-model-lists.json": "YOLO_PI_MODEL_LISTS",
          ".pi/agent/yolo-openai-codex-models.json": "YOLO_PI_OPENAI_CODEX_MODELS"
        }
      },
      "model_catalog": [
        "node_modules/@earendil-works/pi-ai/dist/providers/data/*.json"
      ],
      "node_floor": "22.19",
      "package": "@earendil-works/pi-coding-agent",
      // A version probe answers at once (pi-extension-store-builds.md XB-D24): pi prints its
      // version right after parsing its arguments. Not --help, which pi answers only after
      // resolving and installing its packages.
      "probe_args": [
        "--version",
        "-v"
      ],
      "protocols": [
        "openai",
        "openai-responses"
      ],
      "provider_sets": true,
      "refresh": {
        "argv": [
          "update",
          "--extensions"
        ],
        "due_on_change": [
          ".pi/agent/settings.json"
        ],
        "lock": ".pi/.yolo-update.lock",
        // Worth running only while a settings file names a package pi installs itself: the
        // prefixes pi parses as a remote source (XB-D23). Not a bare "http, which pi's own
        // keys match, and not "git@, which pi reads as a local path.
        "only_if": {
          "contains": [
            "\"npm:",
            "\"git:",
            "\"http://",
            "\"https://",
            "\"ssh://"
          ],
          "files": [
            ".pi/agent/settings.json"
          ],
          "project_files": [
            ".pi/settings.json"
          ]
        }
      },
      // pi's extension loader caches what it compiles in <tmpdir>/jiti, which a jail restart
      // empties (XB-D52).
      "temp_caches": [
        "jiti"
      ],
      "via": "npm"
    },
    {
      "after": "host:.pi/agent/AGENTS.md",
      "agent": "pi",
      "into": ".pi/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agents": [
        "pi"
      ],
      "from": "briefing/worktrees.md",
      "kind": "briefing"
    },
    {
      "agent": "pi",
      "into": ".pi/agent/skills",
      "kind": "skills",
      "project_dirs": [".pi/skills", ".agents/skills"]
    },
    {
      // Where a pack gives pi one folder laid out as a pi package (extensions/, themes/,
      // prompts/), with {"kind": "files", "agents": ["pi"], "from": "<folder>"}. Each folder is
      // listed in settings.json's `packages`, which loads every file in it with no list
      // (docs/design/pack-pi-resources.md). Outside every folder pi scans by itself, so a folder
      // loads only while its pack is selected.
      "agent": "pi",
      "expects": ["extensions", "themes", "skills", "prompts", "package.json"],
      "into": ".pi/agent/yolo-packs",
      "kind": "files",
      "register": {"path": "/packages", "surface": "pi/settings"}
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "from": "extensions/yolo-openai-auth.js",
      "into": ".pi/agent/extensions/yolo-openai-auth.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-model-lists.js",
      "into": ".pi/agent/extensions/yolo-model-lists.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".pi/agent/extensions/yolo-footer.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-durable-worktrees.js",
      "into": ".pi/agent/extensions/yolo-durable-worktrees.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "theme": "light/dark"
          },
          "name": "settings",
          "path": "~/.pi/agent/settings.json",
          "readsHost": true,
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "providers": {}
          },
          "mode": "computed",
          "name": "models",
          "path": "~/.pi/agent/models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "codex-models",
          "path": "~/.pi/agent/yolo-openai-codex-models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "model-lists",
          "path": "~/.pi/agent/yolo-model-lists.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "name": "mcp",
          "path": "~/.pi/agent/mcp.json",
          "retireIfMatchesRender": [
            "mcp-adapter.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "name": "subagents-mcp",
          "notAtHost": "~/.config/mcp/mcp.json is a cross-tool MCP file you keep, and at the host your MCP servers go to pi's own ~/.pi/agent/mcp.json instead; it is written only in a jail",
          "path": "~/.config/mcp/mcp.json",
          "whenListed": {
            "matches": "(^npm:|/)pi-subagents(@[^/]*)?(\\.git)?$",
            "member": "source",
            "path": "/packages",
            "surface": "pi/settings"
          }
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "always"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "ask"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "kind": "env",
      "vars": {
        "PI_TELEMETRY": "0"
      }
    },
    {
      "at": ".pi",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".pi-shared-npm",
      "from": ".pi/agent/npm",
      "hook": "unshare_directory",
      "kind": "hook"
    },
    {
      "at": ".pi-shared-git",
      "from": ".pi/agent/git",
      "hook": "unshare_directory",
      "kind": "hook"
    }
  ],
  "name": "pi",
  "needs": [
    {
      "pack": "bedrock"
    },
    {
      "pack": "openai-auth"
    }
  ]
}
