{
  "hostFiles": [
    {
      "from": ".pi/agent/settings.json",
      "to": "host-pi/settings.json"
    }
  ],
  "install": {
    "bin": "pi",
    "flags": [
      "--ignore-scripts"
    ],
    "kind": "npm",
    "package": "@earendil-works/pi-coding-agent"
  },
  "mounts": [
    {
      "from": "AGENTS.md",
      "hostOverlay": ".pi/agent/AGENTS.md",
      "to": ".pi/agent/AGENTS.md"
    },
    {
      "from": "skills",
      "to": ".pi/agent/skills"
    }
  ],
  "name": "pi",
  "surfaces": [
    {
      "agent": "pi",
      "codec": "json",
      "defaults": {
        "theme": "system"
      },
      "managed": {
        "defaultProjectTrust": "always"
      },
      "name": "settings",
      "path": "~/.pi/agent/settings.json",
      "retireOnFirstRender": [
        "yolo-host-synced-settings.json"
      ]
    }
  ],
  "writableDirs": [
    ".pi"
  ]
}
