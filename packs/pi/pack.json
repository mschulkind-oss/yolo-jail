{
  "contributes": [
    {
      "bin": "pi",
      "flags": [
        "--ignore-scripts"
      ],
      "kind": "program",
      "package": "@earendil-works/pi-coding-agent",
      "via": "npm"
    },
    {
      "after": "host:.pi/agent/AGENTS.md",
      "from": "AGENTS.md",
      "into": ".pi/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "from": "skills",
      "into": ".pi/agent/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "theme": "system"
          },
          "managed": {
            "defaultProjectTrust": "always"
          },
          "name": "settings",
          "path": "~/.pi/agent/settings.json",
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "at": ".pi",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "host": ".pi/agent/settings.json",
      "into": "host-pi/settings.json",
      "kind": "reads-host"
    }
  ],
  "name": "pi"
}
