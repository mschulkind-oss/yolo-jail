{
  "contributes": [
    {
      "bin": "pi",
      "flags": [
        "--ignore-scripts"
      ],
      "install_hints": {
        "brew": "pi-coding-agent",
        "dnf": "pi-coding-agent"
      },
      "kind": "program",
      "model_catalog": [
        "node_modules/@earendil-works/pi-ai/dist/providers/data/*.json"
      ],
      "node_floor": "22.19",
      "package": "@earendil-works/pi-coding-agent",
      "protocols": [
        "openai",
        "openai-responses"
      ],
      "provider_sets": true,
      "refresh": {
        "argv": [
          "update",
          "--extensions"
        ],
        "due_on_change": [
          ".pi/agent/settings.json"
        ],
        "lock": ".pi-shared-npm/.yolo-update.lock"
      },
      "via": "npm"
    },
    {
      "after": "host:.pi/agent/AGENTS.md",
      "agent": "pi",
      "into": ".pi/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agents": [
        "pi"
      ],
      "from": "briefing/worktrees.md",
      "kind": "briefing"
    },
    {
      "agent": "pi",
      "into": ".pi/agent/skills",
      "kind": "skills",
      "project_dirs": [".pi/skills", ".agents/skills"]
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "from": "extensions/yolo-openai-auth.js",
      "into": ".pi/agent/extensions/yolo-openai-auth.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-model-lists.js",
      "into": ".pi/agent/extensions/yolo-model-lists.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".pi/agent/extensions/yolo-footer.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-durable-worktrees.js",
      "into": ".pi/agent/extensions/yolo-durable-worktrees.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "theme": "light/dark"
          },
          "name": "settings",
          "path": "~/.pi/agent/settings.json",
          "readsHost": true,
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "providers": {}
          },
          "mode": "computed",
          "name": "models",
          "path": "~/.pi/agent/models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "codex-models",
          "path": "~/.pi/agent/yolo-openai-codex-models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "model-lists",
          "path": "~/.pi/agent/yolo-model-lists.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "mode": "computed",
          "name": "mcp",
          "path": "~/.pi/agent/mcp-adapter.json",
          "retireIfMatchesRender": [
            "mcp.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "name": "subagents-mcp",
          "notAtHost": "~/.config/mcp/mcp.json is a cross-tool MCP file you keep, and `yolo host apply` renders no MCP servers, so it would carry none of yours; it is written only in a jail",
          "path": "~/.config/mcp/mcp.json",
          "whenListed": {
            "matches": "(^npm:|/)pi-subagents(@[^/]*)?(\\.git)?$",
            "member": "source",
            "path": "/packages",
            "surface": "pi/settings"
          }
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "always"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "ask"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "at": ".pi",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".pi-shared-npm",
      "because": "the extension package store, shared so every workspace on the machine runs one version of an extension instead of N that drift",
      "kind": "state",
      "scope": "machine"
    },
    {
      "at": ".pi-shared-npm",
      "from": ".pi/agent/npm",
      "hook": "shared_directory",
      "kind": "hook"
    },
    {
      "at": ".pi-shared-git",
      "from": ".pi/agent/git",
      "hook": "unshare_directory",
      "kind": "hook"
    }
  ],
  "name": "pi",
  "needs": [
    {
      "pack": "bedrock"
    },
    {
      "pack": "openai-auth"
    }
  ]
}
