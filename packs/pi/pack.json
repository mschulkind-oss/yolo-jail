{
  "contributes": [
    // Where each install hint's name came from, one line per manager, checked 2026-10-02.
    //   brew: https://formulae.brew.sh/api/formula/pi-coding-agent.json (bin/pi in its formula source)
    //   dnf: https://packages.fedoraproject.org/pkgs/pi-coding-agent/pi-coding-agent/fedora-rawhide.html#files (/usr/bin/pi; only in Fedora 45, unreleased on 2026-10-02, and Rawhide, so dnf finds no such package on Fedora 43 or 44)
    {
      "bin": "pi",
      "flags": [
        "--ignore-scripts"
      ],
      "install_hints": {
        "brew": "pi-coding-agent",
        "dnf": "pi-coding-agent"
      },
      "kind": "program",
      // How `yolo host -p <profile> -- pi` moves pi for one launch without touching
      // ~/.pi/agent/settings.json (docs/design/model-lists-and-pickers.md MM-D30): the settings
      // derive's selection as pi's own flags, --provider and --model choosing the session's model
      // and --models replacing enabledModels (MEASURED on pi 1.0.1); and the two model-list files
      // pi's extensions read, as this launch composes them, in the variables those extensions read
      // before the files (extensions/yolo-openai-auth.js, extensions/yolo-model-lists.js). None
      // of it goes in front of a subcommand: pi 1.0.1 reads one only as its first word
      // (main.js's runAuthCommand, handlePackageCommand, handleConfigCommand and `mcp`, read in
      // the installed dist, never run), so `pi --provider zai update` would start a session whose
      // first prompt is "update".
      "launch_selection": {
        "flags": [
          {
            "argv": [
              "--provider",
              "{value}"
            ],
            "key": "defaultProvider"
          },
          {
            "argv": [
              "--model",
              "{value}"
            ],
            "key": "defaultModel"
          },
          {
            "argv": [
              "--models",
              "{value}"
            ],
            "key": "enabledModels"
          }
        ],
        "subcommands": [
          "auth",
          "config",
          "install",
          "list",
          "mcp",
          "remove",
          "uninstall",
          "update"
        ],
        "surface": ".pi/agent/settings.json",
        "surfaces": {
          ".pi/agent/yolo-model-lists.json": "YOLO_PI_MODEL_LISTS",
          ".pi/agent/yolo-openai-codex-models.json": "YOLO_PI_OPENAI_CODEX_MODELS"
        }
      },
      "model_catalog": [
        "node_modules/@earendil-works/pi-ai/dist/providers/data/*.json"
      ],
      "node_floor": "22.19",
      "package": "@earendil-works/pi-coding-agent",
      // A version probe answers at once (pi-extension-store-builds.md XB-D24): pi prints its
      // version right after parsing its arguments. Not --help, which pi answers only after
      // resolving and installing its packages.
      "probe_args": [
        "--version",
        "-v"
      ],
      "protocols": [
        "openai",
        "openai-responses"
      ],
      "provider_sets": true,
      "refresh": {
        "argv": [
          "update",
          "--extensions"
        ],
        "due_on_change": [
          ".pi/agent/settings.json"
        ],
        "lock": ".pi/.yolo-update.lock",
        // Worth running only while a settings file names a package pi installs itself: the
        // prefixes pi parses as a remote source (XB-D23). Not a bare "http, which pi's own
        // keys match, and not "git@, which pi reads as a local path.
        "only_if": {
          "contains": [
            "\"npm:",
            "\"git:",
            "\"http://",
            "\"https://",
            "\"ssh://"
          ],
          "files": [
            ".pi/agent/settings.json"
          ],
          "project_files": [
            ".pi/settings.json"
          ]
        }
      },
      // pi's extension loader caches what it compiles in <tmpdir>/jiti, which a jail restart
      // empties (XB-D52).
      "temp_caches": [
        "jiti"
      ],
      "via": "npm"
    },
    {
      "after": "host:.pi/agent/AGENTS.md",
      "agent": "pi",
      "into": ".pi/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agents": [
        "pi"
      ],
      "from": "briefing/worktrees.md",
      "kind": "briefing"
    },
    {
      "agent": "pi",
      "into": ".pi/agent/skills",
      "kind": "skills",
      "project_dirs": [".pi/skills", ".agents/skills"]
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "from": "extensions/yolo-openai-auth.js",
      "into": ".pi/agent/extensions/yolo-openai-auth.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-model-lists.js",
      "into": ".pi/agent/extensions/yolo-model-lists.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".pi/agent/extensions/yolo-footer.js",
      "kind": "files"
    },
    {
      "from": "extensions/yolo-durable-worktrees.js",
      "into": ".pi/agent/extensions/yolo-durable-worktrees.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "theme": "light/dark"
          },
          "name": "settings",
          "path": "~/.pi/agent/settings.json",
          "readsHost": true,
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "providers": {}
          },
          "mode": "computed",
          "name": "models",
          "path": "~/.pi/agent/models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "codex-models",
          "path": "~/.pi/agent/yolo-openai-codex-models.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "model-lists",
          "path": "~/.pi/agent/yolo-model-lists.json"
        },
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "name": "mcp",
          "path": "~/.pi/agent/mcp.json",
          "retireIfMatchesRender": [
            "mcp-adapter.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "name": "subagents-mcp",
          "notAtHost": "~/.config/mcp/mcp.json is a cross-tool MCP file you keep, and at the host your MCP servers go to pi's own ~/.pi/agent/mcp.json instead; it is written only in a jail",
          "path": "~/.config/mcp/mcp.json",
          "whenListed": {
            "matches": "(^npm:|/)pi-subagents(@[^/]*)?(\\.git)?$",
            "member": "source",
            "path": "/packages",
            "surface": "pi/settings"
          }
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "always"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "ask"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "kind": "env",
      "vars": {
        "PI_TELEMETRY": "0"
      }
    },
    {
      "at": ".pi",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".pi-shared-npm",
      "from": ".pi/agent/npm",
      "hook": "unshare_directory",
      "kind": "hook"
    },
    {
      "at": ".pi-shared-git",
      "from": ".pi/agent/git",
      "hook": "unshare_directory",
      "kind": "hook"
    }
  ],
  "name": "pi",
  "needs": [
    {
      "pack": "bedrock"
    },
    {
      "pack": "openai-auth"
    }
  ]
}
