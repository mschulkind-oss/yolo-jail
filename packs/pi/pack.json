{
  "contributes": [
    {
      "bin": "pi",
      "flags": [
        "--ignore-scripts"
      ],
      "install_hints": {
        "brew": "pi-coding-agent",
        "dnf": "pi-coding-agent"
      },
      "kind": "program",
      "package": "@earendil-works/pi-coding-agent",
      "via": "npm"
    },
    {
      "after": "host:.pi/agent/AGENTS.md",
      "agent": "pi",
      "into": ".pi/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "pi",
      "into": ".pi/agent/skills",
      "kind": "skills"
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "kind": "env",
      "profile": "codex",
      "vars": {
        "YOLO_AUTH_PRELAUNCH_BIN": "pi",
        "YOLO_AUTH_PRELAUNCH_FLAG": "--pi-auth",
        "YOLO_AUTH_PRELAUNCH_PATH": ".pi/agent/auth.json"
      }
    },
    {
      "from": "extensions/yolo-openai-auth.js",
      "into": ".pi/agent/extensions/yolo-openai-auth.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "pi",
          "codec": "json",
          "defaults": {
            "theme": "system"
          },
          "name": "settings",
          "path": "~/.pi/agent/settings.json",
          "readsHost": true,
          "retireOnFirstRender": [
            "yolo-host-synced-settings.json"
          ]
        },
        {
          "agent": "pi",
          "codec": "json",
          "mode": "computed",
          "name": "models",
          "path": "~/.pi/agent/models.json"
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "always"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "pi",
            "codec": "json",
            "managed": {
              "defaultProjectTrust": "ask"
            },
            "name": "settings",
            "path": "~/.pi/agent/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "at": ".pi",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "pi",
  "needs": [
    {
      "pack": "openai-auth"
    }
  ]
}
