{
  "model_list_check": {
    "oh-omp": {}
  },
  "contributes": [
    {
      "bin": "oh-omp",
      // omp's own providers, read from the oh-omp 0.15.3 linux-x64 binary's strings on 2026-10-05,
      // never run: every provider its bundled packages/ai/src/models.json lists, and the local and
      // gateway ones its key map (serviceProviderMap) adds. yolo writes no model entry over one
      // (docs/design/pi-codex-provider-shadowing.md OQ-3). omp's own zai speaks Anthropic Messages
      // at api.z.ai/api/anthropic, the coding plan's Anthropic route (docs/reference/zai-plumbing.md),
      // reading ZAI_API_KEY, so yolo's zai needs no plan.
      "built_in_providers": {
        "names": [
          "alibaba-coding-plan", "amazon-bedrock", "anthropic", "azure-openai-responses",
          "cerebras", "cloudflare-ai-gateway", "cursor", "deepseek", "github-copilot", "gitlab-duo",
          "google", "google-antigravity", "google-gemini-cli", "google-vertex", "groq",
          "huggingface", "kilo", "kimi-code", "litellm", "llama.cpp", "lm-studio", "minimax",
          "minimax-cn", "minimax-code", "minimax-code-cn", "mistral", "moonshot", "nanogpt",
          "nvidia", "ollama", "openai", "openai-codex", "opencode", "opencode-go", "opencode-zen",
          "openrouter", "qianfan", "qwen-portal", "runpod", "synthetic", "together", "venice",
          "vercel-ai-gateway", "vllm", "xai", "xai-oauth", "xiaomi", "zai", "zenmux"
        ]
      },
      "kind": "program",
      // How `yolo host -p <profile> -- oh-omp` moves oh-omp's scope for one launch without
      // touching ~/.oh-omp/agent/config.yml (docs/design/model-lists-and-pickers.md MM-D30): the
      // settings derive's one selection key, enabledModels under an `only`, as --models, which
      // 0.15.3 reads in its place (`parsedArgs.models ?? settings.get("enabledModels")`, read in
      // the shipped binary, never run) and splits on commas. Never in front of a subcommand:
      // 0.15.3's runCli reads its first word as one only when it does not start with "-" (and
      // `help` alone), else runs `launch` with every word, so `oh-omp --models ... commit` would
      // start a session whose first prompt is "commit". The words are its command table's names
      // and aliases, read in the same binary.
      "launch_selection": {
        "flags": [
          {
            "argv": [
              "--models",
              "{value}"
            ],
            "key": "enabledModels"
          }
        ],
        "subcommands": [
          "agents",
          "auth",
          "commit",
          "config",
          "grep",
          "help",
          "jupyter",
          "launch",
          "plugin",
          "q",
          "search",
          "setup",
          "shell",
          "ssh",
          "stats",
          "update"
        ],
        "surface": ".oh-omp/agent/config.yml"
      },
      "package": "@oh-labs/oh-omp@0.15.3",
      "platforms": [
        "darwin/arm64",
        "linux/amd64"
      ],
      // A version probe answers at once (pi-extension-store-builds.md XB-D24, XB-D51): the
      // word the per-pack install matrix runs (integration/agents_test.go).
      "probe_args": [
        "--version"
      ],
      "protocols": [
        "openai",
        "anthropic"
      ],
      "provider_sets": true,
      "via": "npm"
    },
    {
      "after": "host:.oh-omp/agent/AGENTS.md",
      "agent": "oh-omp",
      "into": ".oh-omp/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "oh-omp",
      "into": ".oh-omp/agent/skills",
      "kind": "skills"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".oh-omp/agent/extensions/yolo-footer/index.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "mode": "computed",
          "name": "models",
          "path": "~/.oh-omp/agent/models.yml"
        },
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "name": "settings",
          "path": "~/.oh-omp/agent/config.yml"
        }
      ],
      "kind": "config"
    },
    {
      "at": ".oh-omp",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "omp"
}
