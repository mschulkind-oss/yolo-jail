{
  "contributes": [
    {
      "bin": "oh-omp",
      "kind": "program",
      // How `yolo host -p <profile> -- oh-omp` moves oh-omp's scope for one launch without
      // touching ~/.oh-omp/agent/config.yml (docs/design/model-lists-and-pickers.md MM-D30): the
      // settings derive's one selection key, enabledModels under an `only`, as --models, which
      // 0.15.3 reads in its place (`parsedArgs.models ?? settings.get("enabledModels")`, read in
      // the shipped binary, never run) and splits on commas.
      "launch_selection": {
        "flags": [
          {
            "argv": [
              "--models",
              "{value}"
            ],
            "key": "enabledModels"
          }
        ],
        "surface": ".oh-omp/agent/config.yml"
      },
      "package": "@oh-labs/oh-omp@0.15.3",
      "platforms": [
        "darwin/arm64",
        "linux/amd64"
      ],
      "protocols": [
        "openai",
        "anthropic"
      ],
      "provider_sets": true,
      "via": "npm"
    },
    {
      "after": "host:.oh-omp/agent/AGENTS.md",
      "agent": "oh-omp",
      "into": ".oh-omp/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "oh-omp",
      "into": ".oh-omp/agent/skills",
      "kind": "skills"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".oh-omp/agent/extensions/yolo-footer/index.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "mode": "computed",
          "name": "models",
          "path": "~/.oh-omp/agent/models.yml"
        },
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "name": "settings",
          "path": "~/.oh-omp/agent/config.yml"
        }
      ],
      "kind": "config"
    },
    {
      "at": ".oh-omp",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "omp"
}
