{
  "contributes": [
    {
      "bin": "oh-omp",
      "kind": "program",
      "package": "@oh-labs/oh-omp@0.15.3",
      "platforms": [
        "darwin/arm64",
        "linux/amd64"
      ],
      // A version probe answers at once (pi-extension-store-builds.md XB-D24, XB-D51): the
      // word the per-pack install matrix runs (integration/agents_test.go).
      "probe_args": [
        "--version"
      ],
      "protocols": [
        "openai",
        "anthropic"
      ],
      "provider_sets": true,
      "via": "npm"
    },
    {
      "after": "host:.oh-omp/agent/AGENTS.md",
      "agent": "oh-omp",
      "into": ".oh-omp/agent/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "oh-omp",
      "into": ".oh-omp/agent/skills",
      "kind": "skills"
    },
    {
      "from": "extensions/yolo-footer.js",
      "into": ".oh-omp/agent/extensions/yolo-footer/index.js",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "mode": "computed",
          "name": "models",
          "path": "~/.oh-omp/agent/models.yml"
        },
        {
          "agent": "oh-omp",
          "codec": "yaml",
          "name": "settings",
          "path": "~/.oh-omp/agent/config.yml"
        }
      ],
      "kind": "config"
    },
    {
      "at": ".oh-omp",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "omp"
}
