{
  "flagAliases": {
    "--yolo": [
      "-y"
    ]
  },
  "install": {
    "bin": "copilot",
    "kind": "npm",
    "package": "@github/copilot"
  },
  "launchFlags": {
    "copilot": [
      "--yolo",
      "--no-auto-update"
    ]
  },
  "mounts": [
    {
      "from": "AGENTS.md",
      "hostOverlay": ".copilot/AGENTS.md",
      "to": ".copilot/AGENTS.md"
    },
    {
      "from": "skills",
      "to": ".copilot/skills"
    }
  ],
  "name": "copilot",
  "retireMiseTools": [
    "\"npm:@github/copilot\""
  ],
  "surfaces": [
    {
      "agent": "copilot",
      "codec": "json",
      "defaults": {
        "yolo": true
      },
      "mode": "rmw",
      "name": "config",
      "path": "~/.copilot/config.json"
    },
    {
      "agent": "copilot",
      "codec": "json",
      "computed": [
        {
          "from": "lsp_servers",
          "project": {
            "ops": [
              {
                "copy": {
                  "from": "command",
                  "omitEmpty": true
                }
              },
              {
                "copy": {
                  "from": "args"
                }
              },
              {
                "default": {
                  "to": "args",
                  "value": []
                }
              },
              {
                "copy": {
                  "from": "fileExtensions"
                }
              },
              {
                "default": {
                  "to": "fileExtensions",
                  "value": {}
                }
              }
            ]
          },
          "to": "lspServers"
        }
      ],
      "defaults": {
        "lspServers": {}
      },
      "mode": "computed",
      "name": "lsp",
      "path": "~/.copilot/lsp-config.json"
    },
    {
      "agent": "copilot",
      "codec": "json",
      "computed": [
        {
          "from": "mcp_servers",
          "to": "mcpServers"
        }
      ],
      "defaults": {
        "mcpServers": {}
      },
      "mode": "computed",
      "name": "mcp",
      "path": "~/.copilot/mcp-config.json"
    }
  ],
  "writableDirs": [
    ".copilot"
  ]
}
