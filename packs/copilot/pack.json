{
  "contributes": [
    // Where the install hint's name came from, checked 2026-10-02. A cask, so "brew-cask".
    //   brew-cask: https://formulae.brew.sh/api/cask/copilot-cli.json (binary artifact `copilot`)
    {
      "bin": "copilot",
      "install_hints": {
        "brew-cask": "copilot-cli"
      },
      "kind": "program",
      "package": "@github/copilot",
      // A version probe answers at once (pi-extension-store-builds.md XB-D24, XB-D29): the
      // word the per-pack install matrix runs (integration/agents_test.go).
      "probe_args": [
        "--version"
      ],
      "protocols": [
        "anthropic",
        "openai"
      ],
      "unlisted_background_models": true,
      "via": "npm"
    },
    {
      "after": "host:.copilot/copilot-instructions.md",
      "agent": "copilot",
      "into": ".copilot/copilot-instructions.md",
      "kind": "briefing"
    },
    {
      "agent": "copilot",
      "into": ".copilot/skills",
      "kind": "skills",
      "project_dirs": [".github/skills", ".agents/skills", ".claude/skills"]
    },
    {
      "config": [
        {
          "agent": "copilot",
          "codec": "json",
          "defaults": {
            "yolo": true
          },
          "mode": "rmw",
          "name": "config",
          "path": "~/.copilot/config.json"
        },
        {
          "agent": "copilot",
          "codec": "json",
          "defaults": {
            "statusLine": {
              "command": "test ! -r ~/.copilot/yolo/footer.sh || sh ~/.copilot/yolo/footer.sh",
              "type": "command"
            }
          },
          "mode": "rmw",
          "name": "settings",
          "path": "~/.copilot/settings.json"
        }
      ],
      "kind": "config"
    },
    {
      "from": "footer/yolo-footer.sh",
      "into": ".copilot/yolo/footer.sh",
      "kind": "files"
    },
    {
      "config": [
        {
          "agent": "copilot",
          "codec": "json",
          "defaults": {
            "lspServers": {}
          },
          "mode": "computed",
          "name": "lsp",
          "path": "~/.copilot/lsp-config.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "copilot",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "mode": "computed",
          "name": "mcp",
          "path": "~/.copilot/mcp-config.json"
        }
      ],
      "kind": "config"
    },
    {
      "at": ".copilot",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "autonomous": {
        "launch": [
          {
            "bin": "copilot",
            "flags": [
              "--yolo"
            ]
          }
        ]
      },
      "kind": "autonomy"
    }
  ],
  "name": "copilot",
  "skills_tier": "namespaced"
}
