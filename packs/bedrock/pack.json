{
  "contributes": [
    {
      "api_key_env_name": [
        "AWS_BEARER_TOKEN_BEDROCK",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_PROFILE",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI"
      ],
      "kind": "provider",
      "model_options": {
        "global.anthropic.claude-opus-5-5": {
          "context_window": "1000000",
          "input": "text,image",
          "max_tokens": "128000",
          "name": "Claude Opus 5.5 (Global)",
          "order": "1",
          "reasoning": "true",
          "vendor": "anthropic"
        },
        "global.openai.gpt-6-astra": {
          "context_window": "1050000",
          "input": "text,image",
          "max_tokens": "128000",
          "name": "GPT-6 Astra (Global)",
          "order": "4",
          "vendor": "openai"
        },
        "global.openai.gpt-6-sol": {
          "context_window": "1050000",
          "input": "text,image",
          "max_tokens": "128000",
          "name": "GPT-6 Sol (Global)",
          "order": "2",
          "reasoning": "true",
          "vendor": "openai"
        },
        "us.openai.gpt-6.1-sol": {
          "context_window": "1000000",
          "input": "text,image",
          "max_tokens": "131072",
          "name": "GPT-6.1 Sol (US)",
          "order": "3",
          "vendor": "openai"
        }
      },
      "models": {
        "global.anthropic.claude-opus-5-5": "global.anthropic.claude-opus-5-5",
        "global.openai.gpt-6-astra": "global.openai.gpt-6-astra",
        "global.openai.gpt-6-sol": "global.openai.gpt-6-sol",
        "us.openai.gpt-6.1-sol": "us.openai.gpt-6.1-sol"
      },
      "name": "bedrock",
      "platform": "aws-bedrock",
      "region_env_name": [
        "AWS_REGION",
        "AWS_DEFAULT_REGION"
      ]
    },
    {
      "kind": "profile",
      "name": "bedrock",
      "provider": "bedrock"
    },
    {
      "kind": "profile",
      "name": "bedrock-bridge",
      "provider": "bedrock",
      "via": "wire-bridge"
    }
  ],
  "description": "Amazon Bedrock's bedrock-runtime endpoint as one provider every agent reads, with the models an agent starts on there.",
  "name": "bedrock",
  "needs": [
    {
      "pack": "aws-auth"
    }
  ]
}
