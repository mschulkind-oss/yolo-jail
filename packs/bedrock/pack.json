{
  "contributes": [
    {
      "api_key_env_name": [
        "AWS_BEARER_TOKEN_BEDROCK",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SESSION_TOKEN",
        "AWS_PROFILE",
        "AWS_CONTAINER_CREDENTIALS_FULL_URI"
      ],
      "kind": "provider",
      "name": "bedrock",
      "platform": "aws-bedrock",
      "region_env_name": [
        "AWS_REGION",
        "AWS_DEFAULT_REGION"
      ],
      "region_file": {
        "default_profile": "default",
        "key": "region",
        "path": ".aws/config",
        "path_env_name": "AWS_CONFIG_FILE",
        "profile_env_name": "AWS_PROFILE",
        "profile_section": "profile {profile}"
      }
    },
    {
      "kind": "profile",
      "name": "bedrock",
      "provider": "bedrock"
    },
    {
      "kind": "profile",
      "name": "bedrock-bridge",
      "provider": "bedrock",
      "via": "wire-bridge"
    }
  ],
  "description": "Amazon Bedrock's bedrock-runtime endpoint as one provider every agent reads. It ships no model list: each agent starts on its own Bedrock default, and a pack or your config may add one.",
  "name": "bedrock",
  "needs": [
    {
      "pack": "aws-auth"
    }
  ]
}
