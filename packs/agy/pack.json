{
  "contributes": [
    {
      "bin": "agy",
      "install_hints": {
        "brew-cask": "antigravity-cli",
        "nix": "antigravity-cli"
      },
      "kind": "program",
      "url": "https://antigravity.google/cli/install.sh",
      "via": "installer"
    },
    {
      "after": "host:.gemini/antigravity-cli/AGENTS.md",
      "from": "AGENTS.md",
      "into": ".gemini/antigravity-cli/AGENTS.md",
      "kind": "briefing"
    },
    {
      "from": "skills",
      "into": ".gemini/antigravity-cli/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "mode": "computed",
          "name": "mcp",
          "path": "~/.gemini/antigravity-cli/mcp_config.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "name": "settings",
          "path": "~/.gemini/antigravity-cli/settings.json"
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "agy",
            "codec": "json",
            "managed": {
              "permissionMode": "allow"
            },
            "name": "settings",
            "path": "~/.gemini/antigravity-cli/settings.json"
          }
        ],
        "launch": [
          {
            "bin": "agy",
            "flags": [
              "--dangerously-skip-permissions"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "agy",
            "codec": "json",
            "managed": {
              "toolPermission": "strict"
            },
            "name": "settings",
            "path": "~/.gemini/antigravity-cli/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "at": ".gemini/antigravity-cli",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "agy"
}
