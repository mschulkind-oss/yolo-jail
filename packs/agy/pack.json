{
  "contributes": [
    {
      "bin": "agy",
      "capabilities": [
        "web_search"
      ],
      "install_hints": {
        "brew-cask": "antigravity-cli"
      },
      "kind": "program",
      "update": [
        "update"
      ],
      "url": "https://antigravity.google/cli/install.sh",
      "via": "installer"
    },
    {
      "after": "host:.gemini/config/AGENTS.md",
      "agent": "agy",
      "into": ".gemini/config/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "agy",
      "into": ".gemini/config/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "mode": "computed",
          "name": "mcp",
          "path": "~/.gemini/antigravity-cli/mcp_config.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "defaults": {
            "statusLine": {
              "command": "yolo internal footer --agent agy --login 'Google AI subscription' --template 'yolo: {yolo.billing} · {yolo.notch}'",
              "stack_with_default": true,
              "type": "command"
            }
          },
          "name": "settings",
          "path": "~/.gemini/antigravity-cli/settings.json"
        },
        {
          "agent": "agy",
          "codec": "json",
          "name": "onboarding",
          "path": "~/.gemini/antigravity-cli/cache/onboarding.json"
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "agy",
            "codec": "json",
            "managed": {
              "permissionMode": "allow",
              "trustedWorkspaces": [
                "/workspace"
              ]
            },
            "name": "settings",
            "path": "~/.gemini/antigravity-cli/settings.json"
          }
        ],
        "launch": [
          {
            "bin": "agy",
            "flags": [
              "--dangerously-skip-permissions"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "agy",
            "codec": "json",
            "managed": {
              "toolPermission": "strict"
            },
            "name": "settings",
            "path": "~/.gemini/antigravity-cli/settings.json"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "at": ".gemini",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "at": ".gemini-shared-credentials",
      "because": "identity/credential state shared across workspaces",
      "kind": "state",
      "scope": "machine"
    },
    {
      "at": ".gemini-shared-credentials",
      "from": ".gemini/antigravity-cli/antigravity-oauth-token",
      "hook": "shared_credentials",
      "kind": "hook"
    }
  ],
  "name": "agy"
}
