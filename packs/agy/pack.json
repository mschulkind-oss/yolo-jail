{
  "contributes": [
    {
      "bin": "agy",
      "kind": "program",
      "url": "https://antigravity.google/cli/install.sh",
      "via": "installer"
    },
    {
      "after": "host:.gemini/antigravity-cli/AGENTS.md",
      "from": "AGENTS.md",
      "into": ".gemini/antigravity-cli/AGENTS.md",
      "kind": "briefing"
    },
    {
      "from": "skills",
      "into": ".gemini/antigravity-cli/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "defaults": {
            "mcpServers": {}
          },
          "mode": "computed",
          "name": "mcp",
          "path": "~/.gemini/antigravity-cli/mcp_config.json"
        }
      ],
      "kind": "config"
    },
    {
      "config": [
        {
          "agent": "agy",
          "codec": "json",
          "managed": {
            "permissionMode": "allow"
          },
          "name": "settings",
          "path": "~/.gemini/antigravity-cli/settings.json"
        }
      ],
      "kind": "config"
    },
    {
      "at": ".gemini/antigravity-cli",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "bin": "agy",
      "flags": [
        "--dangerously-skip-permissions"
      ],
      "kind": "launch"
    }
  ],
  "name": "agy"
}
