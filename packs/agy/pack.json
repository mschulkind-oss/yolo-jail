{
  "name": "agy",
  "install": {
    "kind": "native",
    "bin": "agy",
    "installerUrl": "https://antigravity.google.com/install.sh"
  },
  "mounts": [
    {
      "from": "AGENTS.md",
      "to": ".gemini/antigravity-cli/AGENTS.md",
      "hostOverlay": ".gemini/antigravity-cli/AGENTS.md"
    },
    {
      "from": "skills",
      "to": ".gemini/antigravity-cli/skills"
    }
  ],
  "writableDirs": [
    ".gemini/antigravity-cli"
  ],
  "surfaces": [
    {
      "agent": "agy",
      "codec": "json",
      "managed": {
        "permissionMode": "allow"
      },
      "name": "settings",
      "path": "~/.gemini/antigravity-cli/settings.json"
    },
    {
      "agent": "agy",
      "codec": "json",
      "defaults": {
        "mcpServers": {}
      },
      "mode": "computed",
      "name": "mcp",
      "path": "~/.gemini/antigravity-cli/mcp_config.json"
    }
  ],
  "launchFlags": {
    "agy": [
      "--dangerously-skip-permissions"
    ]
  }
}
