{
  "contributes": [
    {
      "bin": "codex",
      "kind": "program",
      "package": "@openai/codex",
      "via": "npm"
    },
    {
      "after": "host:.codex/AGENTS.md",
      "from": "AGENTS.md",
      "into": ".codex/AGENTS.md",
      "kind": "briefing"
    },
    {
      "from": "skills",
      "into": ".codex/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "codex",
          "codec": "toml",
          "managed": {
            "approval_policy": "never",
            "sandbox_mode": "danger-full-access"
          },
          "name": "config",
          "path": "~/.codex/config.toml",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "at": ".codex",
      "kind": "state",
      "scope": "workspace"
    },
    {
      "bin": "codex",
      "flags": [
        "--dangerously-bypass-approvals-and-sandbox"
      ],
      "kind": "launch"
    }
  ],
  "name": "codex"
}
