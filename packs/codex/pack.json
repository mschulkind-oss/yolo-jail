{
  "contributes": [
    {
      "bin": "codex",
      "install_hints": {
        "brew-cask": "codex",
        "pacman": "openai-codex"
      },
      "kind": "program",
      "package": "@openai/codex",
      "via": "npm"
    },
    {
      "after": "host:.codex/AGENTS.md",
      "into": ".codex/AGENTS.md",
      "kind": "briefing"
    },
    {
      "into": ".codex/skills",
      "kind": "skills"
    },
    {
      "config": [
        {
          "agent": "codex",
          "codec": "toml",
          "name": "config",
          "path": "~/.codex/config.toml",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        }
      ],
      "kind": "config"
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "codex",
            "codec": "toml",
            "managed": {
              "approval_policy": "never",
              "sandbox_mode": "danger-full-access"
            },
            "name": "config",
            "path": "~/.codex/config.toml"
          }
        ],
        "launch": [
          {
            "bin": "codex",
            "flags": [
              "--dangerously-bypass-approvals-and-sandbox"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "codex",
            "codec": "toml",
            "managed": {
              "approval_policy": "on-request",
              "sandbox_mode": "workspace-write"
            },
            "name": "config",
            "path": "~/.codex/config.toml"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "at": ".codex",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "codex"
}
