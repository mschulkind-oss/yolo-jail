{
  "contributes": [
    // Where each install hint's name came from, one line per manager, checked 2026-10-02.
    //   brew-cask: https://formulae.brew.sh/api/cask/codex.json (binary artifact bin/codex, linked as `codex`; there is no codex formula)
    //   pacman: https://archlinux.org/packages/extra/x86_64/openai-codex/files/ (usr/bin/codex)
    {
      "bin": "codex",
      "install_hints": {
        "brew-cask": "codex",
        "pacman": "openai-codex"
      },
      "kind": "program",
      // How `yolo host -p <profile> -- codex` moves codex for one launch without touching
      // ~/.codex/config.toml (docs/design/model-lists-and-pickers.md MM-D30): the config derive's
      // selection and the provider row it names, each as `-c <dotted key>=<TOML value>`, which
      // codex applies over its config file (MEASURED on codex 0.145.0). The subscription's
      // selection names no model_provider, which a jail's render clears; here `openai`, codex's
      // built-in subscription provider, stands for that clear (MEASURED: it loads with no row).
      "launch_selection": {
        "defaults": {
          "model_provider": "openai"
        },
        "each": [
          "-c",
          "{key}={value}"
        ],
        "rows": {
          "named_by": [
            "model_provider"
          ],
          "table": "model_providers"
        },
        "surface": ".codex/config.toml"
      },
      "model_menu": {
        "catalog": [
          "debug",
          "models",
          "--bundled"
        ],
        "clear": [
          "upgrade",
          "availability_nux"
        ],
        "entries": "models",
        "flag": [
          "-c",
          "model_catalog_json={into}"
        ],
        "id": "slug",
        "into": ".codex/yolo-model-menu.json",
        "list": ".codex/yolo-model-list.json",
        "name": "display_name",
        "order": "priority",
        "set": {
          "visibility": "list"
        }
      },
      // A version probe answers at once (pi-extension-store-builds.md XB-D24, XB-D51): the
      // word the per-pack install matrix runs (integration/agents_test.go). It skips the model
      // menu, which runs codex once more to print its catalog.
      "probe_args": [
        "--version"
      ],
      "protocols": [
        "openai-responses",
        "openai"
      ],
      "unlisted_background_models": true,
      "update": [
        "update"
      ],
      "url": "https://chatgpt.com/codex/install.sh",
      "versions_dir": ".codex/packages/standalone/releases",
      "via": "installer"
    },
    {
      "after": "host:.codex/AGENTS.md",
      "agent": "codex",
      "into": ".codex/AGENTS.md",
      "kind": "briefing"
    },
    {
      "agent": "codex",
      "into": ".codex/skills",
      "kind": "skills",
      "project_dirs": [".codex/skills", ".agents/skills"]
    },
    {
      "config": [
        {
          "agent": "codex",
          "codec": "toml",
          "managed": {
            "projects": {
              "${workspace}": {
                "trust_level": "trusted"
              }
            },
            "tui": {
              "model_availability_nux": null
            }
          },
          "name": "config",
          "path": "~/.codex/config.toml",
          "retireOnFirstRender": [
            "yolo-managed-mcp-servers.json"
          ]
        },
        {
          "agent": "codex",
          "codec": "json",
          "mode": "computed",
          "name": "model-list",
          "notAtHost": "`yolo host -- codex` composes this list for its own launch, in-process, and builds codex's model menu from it without the file, so at the host the file would name models nothing reads",
          "path": "~/.codex/yolo-model-list.json"
        }
      ],
      "kind": "config"
    },
    {
      "kind": "env",
      "vars": {
        "CODEX_NON_INTERACTIVE": "1",
        "YOLO_AUTH_PRELAUNCH_CODEX_FLAG": "--codex-auth",
        "YOLO_AUTH_PRELAUNCH_CODEX_PATH": ".codex/auth.json"
      }
    },
    {
      "kind": "env",
      "served_by": "openai-auth-broker",
      "vars": {
        "CODEX_REFRESH_TOKEN_URL_OVERRIDE": "http://{listen}/oauth/token"
      }
    },
    {
      "autonomous": {
        "config": [
          {
            "agent": "codex",
            "codec": "toml",
            "managed": {
              "approval_policy": "never",
              "features": {
                "daemon_auto_start": false
              },
              "sandbox_mode": "danger-full-access"
            },
            "name": "config",
            "path": "~/.codex/config.toml"
          }
        ],
        "launch": [
          {
            "bin": "codex",
            "flags": [
              "--dangerously-bypass-approvals-and-sandbox"
            ]
          }
        ]
      },
      "guarded": {
        "config": [
          {
            "agent": "codex",
            "codec": "toml",
            "managed": {
              "approval_policy": "on-request",
              "sandbox_mode": "workspace-write"
            },
            "name": "config",
            "path": "~/.codex/config.toml"
          }
        ]
      },
      "kind": "autonomy"
    },
    {
      "kind": "profile",
      "name": "codex",
      "provider": "openai-codex"
    },
    {
      "at": ".codex",
      "kind": "state",
      "scope": "workspace"
    }
  ],
  "name": "codex",
  "needs": [
    {
      "pack": "bedrock"
    },
    {
      "pack": "openai-auth"
    }
  ]
}
