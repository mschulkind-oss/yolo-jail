{
  // ───────────────────────────────────────────────────────────────
  // YOLO Jail workspace config — for the yolo-jail repo itself.
  //
  // Committed to the repo so every clone shares the same protections
  // and packages.  First-time agents: run `yolo --help` for an
  // overview, `yolo config-ref` for the full field reference, and
  // `yolo check` after every edit to this file.
  // ───────────────────────────────────────────────────────────────
  // Isolation backend: "podman", "container" (Apple Container), or
  // "macos-user" (a sandboxed macOS account, no VM; never auto-detected)
  // (also settable via YOLO_RUNTIME env var)
  // "runtime": "podman",
  // There is no "agents" key — it was removed.  An agent arrives as a pack,
  // named in "packs" (user config only: ~/.config/yolo-jail/config.jsonc).
  // Extra nix packages to include in the jail image.
  // Names must match nixpkgs attribute names (search at https://search.nixos.org/packages).
  // The image rebuilds only when this list changes.
  // Supports plain strings (latest), pinned nixpkgs commits, or version overrides:
  // "packages": [
  //   "postgresql",
  //   {"name": "freetype", "nixpkgs": "<commit-hash>"},
  //   {"name": "freetype", "version": "2.14.1",
  //    "url": "mirror://savannah/freetype/freetype-2.14.1.tar.xz",
  //    "hash": "sha256-..."}
  // ],
  // Find nixpkgs commits for specific versions at: https://lazamar.co.uk/nix-versions/
  "packages": [
    // `just` isn't in the image's corePackages — we need it in the jail
    // to run the Justfile recipes this repo ships (test, lint, deploy).
    "just"
  ],
  // security: tool shims injected into the jail's PATH.  Nothing is
  // blocked by default.  The "guardrails" pack (named in "packs", user
  // config) blocks recursive grep in favor of rg and find in favor of fd;
  // the example below spells out the same two rules by hand, plus one of
  // your own.
  // "security": {
  //   "blocked_tools": [
  //     {
  //       "name": "grep",
  //       // Only block when argv contains one of these shell-glob
  //       // patterns.  Omit to block unconditionally.
  //       "block_flags": ["--recursive", "-r", "-R", "-*[rR]*"]
  //     },
  //     "find",           // string form → unconditional block
  //     "curl"            // add your own tools here
  //   ]
  // },
  "network": {
    // "bridge" (default) or "host"
    "mode": "bridge",
    // Ports to publish in bridge mode ["Host:Container"]
    // "ports": ["8000:8000"]
    // Forward host ports into the jail (appear on localhost inside container)
    // "forward_host_ports": [5432, "8080:9090"]
  },
  "mounts": [
    "~/.local/share/yolo-jail/logs:/ctx/host-yolo-logs",
  ],
  // Environment variables set inside the jail.
  // Ordered list: strings are KEY=VALUE file paths, objects are inline maps.
  // Later entries override earlier ones; workspace config appends to user config.
  // File paths: ~ expanded, relative paths resolve against the workspace root.
  // Missing files warn and skip; keep secrets out of the dotfiles-synced config.
  // "env_sources": [
  //   "~/.config/yolo-jail/defaults.env",
  //   {"DEBUG": "1"},
  //   ".secrets/claude.env"
  // ]
  // Extra tools to install via mise (key: tool name, value: version string).
  // No defaults — yolo ships no mise tool of its own. Declare only what you want.
  // "mise_tools": {"neovim": "nightly", "typst": "latest"}
  // Additional language servers. No defaults — declare each server you want; its binary
  // must be on PATH (e.g. via mise_tools) or given as an absolute command.
  // "lsp_servers": {
  //   "rust": {
  //     "command": "rust-analyzer",
  //     "args": [],
  //     "fileExtensions": {".rs": "rust"}
  //   }
  // }
  //
  // Enable built-in MCP server presets by name.
  // Available presets: chrome-devtools, sequential-thinking
  // "mcp_presets": ["chrome-devtools", "sequential-thinking"]
  // Additional custom MCP servers, wired into every selected agent that
  // supports MCP.
  // Add custom servers or set a preset/inherited server to null to disable it.
  // Binary must be on PATH or absolute.
  // "mcp_servers": {
  //   "my-custom": {
  //     "command": "/workspace/scripts/my-mcp-server.py",
  //     "args": []
  //   }
  // }
  // GPU passthrough.  "vendor" selects NVIDIA (default) or AMD ROCm.
  // Run "yolo check" to verify GPU readiness before enabling.
  //
  // NVIDIA: requires the NVIDIA Container Toolkit on the host.
  // "gpu": {
  //   "enabled": true,
  //   "vendor": "nvidia",        // "nvidia" (default) or "amd"
  //   "devices": "all",          // "all", "0", "0,1", or "GPU-<uuid>"
  //   "capabilities": "compute,utility"  // NVIDIA only
  // }
  //
  // AMD ROCm: default "devices" mode needs no host toolkit — just the
  // amdgpu driver and /dev/kfd + /dev/dri render nodes ("capabilities"
  // is NVIDIA-only and is rejected for vendor "amd").
  // "gpu": {
  //   "enabled": true,
  //   "vendor": "amd",
  //   "mode": "devices",         // AMD only: "devices" (default) or "cdi"
  //   "devices": "all",          // "all", "0", or "0,1"
  //   "hsa_override_gfx_version": "11.0.0"  // AMD only, optional
  // }
  // Container resource limits.
  // On Apple Container: applied as VM hardware limits (defaults: half host CPUs/RAM).
  // On Podman: applied as --cpus/--memory flags (no defaults — inherits VM limits).
  // On Linux: also feeds cgroup delegation for in-container yolo-cglimit.
  // "resources": {
  //   "memory": "8g",            // Max memory (b/k/m/g suffix). OOM-killed if exceeded.
  //   "cpus": 4,                 // CPU limit (decimal). e.g. 4, 2.5, "0.5"
  //   "pids_limit": 4096         // Max processes (podman only). Prevents fork bombs.
  // }
}
