{
  "name": "claude-fzf",
  "description": "An fd|fzf custom file finder for Claude Code's @-file completion.",
  "contributes": [
    {
      "kind": "requires",
      "bin": "fd",
      "install_hints": { "brew": "fd", "apt": "fd-find", "dnf": "fd-find", "pacman": "fd", "nix": "fd" }
    },
    {
      "kind": "requires",
      "bin": "fzf",
      "install_hints": { "brew": "fzf", "apt": "fzf", "dnf": "fzf", "pacman": "fzf", "nix": "fzf" }
    },
    {
      "kind": "files",
      "from": "bin",
      "into": ".claude/bin"
    },
    {
      "kind": "config-overlay",
      "surface": "claude/settings",
      "config": {
        "managed": {
          "fileSuggestion": {
            "type": "command",
            "command": "~/.claude/bin/file-suggestion.sh"
          }
        }
      }
    },
    {
      "kind": "briefing",
      "from": "AGENTS.md",
      "into": ".claude/CLAUDE.md"
    }
  ]
}
