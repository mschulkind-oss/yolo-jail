{
  "confinement": "jail",
  "runtime": "podman",
  "packages": ["ripgrep", {"name": "strace", "platforms": ["linux"]}],
  "mounts": ["/srv/reference/handbook", {"host": "~/notes", "at": "/ctx/notes", "mode": "ro", "optional": true}],
  "workspace_readonly": ["docs"],
  "per_side_paths": [".venv"],
  "network": {"mode": "bridge", "ports": ["8000:8000"], "forward_host_ports": [5432]},
  "security": {"blocked_tools": [{"name": "wget", "message": "Use curl", "suggestion": "curl <url>"}]},
  "mise_tools": {"neovim": "nightly"},
  "lsp_servers": {"rust": {"command": "rust-analyzer", "args": [], "fileExtensions": {".rs": "rust"}}},
  "mcp_servers": {"docs-search": {"command": "npx", "args": ["-y", "docs-search-mcp"]}},
  "mcp_presets": ["sequential-thinking"],
  "devices": [{"usb": "0bda:2838", "description": "Radio dongle"}],
  "gpu": {"enabled": true, "devices": "all", "capabilities": "compute,utility"},
  "resources": {"memory": "8g", "cpus": 4, "pids_limit": 4096},
  "env_sources": [{"DEBUG": "1"}, "~/.config/yolo-jail/local.env"],
  "loopholes": {"cgroup-delegate": {"enabled": true}},
  "brokered": {"github": {"repos": ["example-org/widgets"]}},
  "kvm": true,
  "prune": {"warn_threshold_gb": 40},
  "programs": {"autoprune": false},
  "ephemeral_storage": "volume",
  "include_if_found": ["overrides.jsonc"],
  "agents_md_extra": "Prefer small commits.",
  "briefing_provenance": true,
  "cache_relocations": {"huggingface": "@HOME@/reloc/huggingface"},
  "writable_home_dirs": [".pi-lens"],
  "host_files": ["~/.npmrc", {"path": "~/.config/ripgrep/config", "content": "--smart-case\n"}],
  "host_wrappers": true,
  "host_apply_on_launch": true,
  "host_management": "own",
  "host_import_exclusions": {"claude/settings": ["/hooks"]},
  "agent_updates": {"*": true, "claude": false},
  "host_floor": {"*": true, "claude": false},
  "host_path": ["~/.cargo/bin"],
  "provisioners": {"host": ["brew"]},
  "packs": ["claude"],
  "perf_logging": true,
  "update_check": false,
  "promotion_target": "local",
  "providers": {"zai": {"endpoints": {"openai": {"base_url": "https://api.z.ai/api/paas/v4", "wire_api": "openai-chat-completions"}}, "api_key_env_name": "ZAI_API_KEY", "models": {"default": "glm-5.3", "fast": "glm-5.3-flash"}, "options": {"model": "default"}}},
  "model_facts": {"opus-5.5": {"reasoning": true, "input": ["text", "image"], "context_window": 1000000, "max_tokens": 128000}},
  "adapters": {"openai->anthropic": {"address": "http://127.0.0.1:9214"}},
  "profiles": {"zai-fast": {"provider": "zai", "model": "fast"}},
  "profile": {"*": "zai-fast"},
  "required_capabilities": ["web_search"]
}
