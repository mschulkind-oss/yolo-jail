{
  "name": "journal",
  "description": "Read the host's systemd journal from inside the jail (yolo-journalctl). The `read` grant forces --user onto every request; `read_all` passes the request through unchanged.",
  "version": 1,
  "access": "read the host's journal",
  "platforms": [
    "linux"
  ],
  "transport": "loopback-tls",
  "lifecycle": "spawned",
  "grants": [
    {
      "kind": "read",
      "text": "read your user journal",
      "requestable_by_default": true,
      "legacy_enable": true
    },
    {
      "kind": "read_all",
      "text": "read the whole host journal",
      "legacy_setting": "full"
    }
  ],
  "host_daemon": {
    "cmd": [
      "yolo",
      "internal",
      "daemon",
      "journal",
      "--socket",
      "{socket}",
      "--settings",
      "{settings}"
    ],
    "publishes": "socket"
  }
}
