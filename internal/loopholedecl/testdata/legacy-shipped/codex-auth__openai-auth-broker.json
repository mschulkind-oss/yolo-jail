{
  "name": "openai-auth-broker",
  "description": "Serializes OpenAI subscription refreshes across agents, workspaces, hosts, and jails.",
  "version": 1,
  "serves": [
    "openai-oauth-refresh"
  ],
  "transport": "loopback-tls",
  "lifecycle": "spawned",
  "host_daemon": {
    "cmd": [
      "yolo",
      "internal",
      "daemon",
      "openai-auth-broker",
      "--socket",
      "{socket}",
      "--state-file",
      "{state}/credentials.json"
    ],
    "publishes": "socket",
    "detach": true
  },
  "jail_daemon": {
    "cmd": [
      "yolo-jaild",
      "openai-auth-adapter",
      "--listen",
      "{listen}"
    ],
    "listen": "127.0.0.1:1460",
    "restart": "on-failure",
    "caller_token": true,
    "host_cmd": [
      "yolo",
      "internal",
      "daemon",
      "openai-auth-adapter",
      "--listen",
      "{listen}"
    ]
  },
  "state_files": [
    ".mount-sentinel"
  ],
  "doctor_cmd": [
    "yolo",
    "internal",
    "daemon",
    "openai-auth-broker",
    "--self-check",
    "--state-file",
    "{state}/credentials.json"
  ]
}
