{
  "name": "host-processes",
  "description": "Allowlisted view of host processes (yolo-ps). What it may show is the `view` grant: the process names an accepted request names.",
  "version": 1,
  "access": "see host processes",
  "grants": [
    {
      "kind": "view",
      "text": "see",
      "valued": true,
      "value_noun": "process names",
      "legacy_enable": true,
      "legacy_values": "visible"
    }
  ],
  "settings": {
    "fields": {
      "type": "string_list",
      "scope": "user",
      "default": [
        "pid",
        "comm",
        "args",
        "etime",
        "%cpu",
        "%mem",
        "rss"
      ],
      "description": "ps -o columns returned to the jail"
    }
  },
  "default_enabled": false,
  "platforms": [
    "linux",
    "darwin"
  ],
  "requires": {
    "command_on_path": "ps"
  },
  "transport": "loopback-tls",
  "lifecycle": "spawned",
  "host_daemon": {
    "cmd": [
      "yolo",
      "internal",
      "daemon",
      "host-processes",
      "--socket",
      "{socket}",
      "--settings",
      "{settings}"
    ],
    "publishes": "socket"
  },
  "doctor_cmd": [
    "yolo",
    "internal",
    "daemon",
    "host-processes",
    "--self-check",
    "--settings",
    "{settings}"
  ]
}
