{
  "name": "serial",
  "description": "Host USB and serial device bridge (yolo-serial). What it may open is the `devices` grant: the device globs an accepted request names.",
  "version": 1,
  "access": "open host serial devices",
  "grants": [
    {
      "kind": "devices",
      "text": "open",
      "valued": true,
      "value_noun": "device globs",
      "legacy_enable": true,
      "legacy_values": "allowed_devices",
      "legacy_default_values": [
        "/dev/ttyUSB*",
        "/dev/ttyACM*",
        "/dev/cu.usbserial*",
        "/dev/cu.usbmodem*",
        "/dev/serial/by-id/*"
      ]
    }
  ],
  "settings": {
    "default_baud": {
      "type": "int",
      "scope": "user",
      "default": 115200,
      "description": "Default baud rate for serial connections"
    }
  },
  "default_enabled": false,
  "transport": "loopback-tls",
  "lifecycle": "spawned",
  "host_daemon": {
    "cmd": [
      "yolo",
      "internal",
      "daemon",
      "serial",
      "--socket",
      "{socket}",
      "--settings",
      "{settings}"
    ],
    "publishes": "socket"
  },
  "doctor_cmd": [
    "yolo",
    "internal",
    "daemon",
    "serial",
    "--self-check",
    "--settings",
    "{settings}"
  ]
}
