{
  "name": "audio",
  "description": "PipeWire/PulseAudio socket pass-through + ALSA\u2192PipeWire routing \u2014 enables microphone and playback inside the jail (Claude Code /voice, sox, ffmpeg, pipewire-rs, libasound clients). It crosses only under the `use` grant.",
  "version": 1,
  "access": "use the host's microphone and speakers",
  "grants": [
    {
      "kind": "use",
      "text": "use your microphone and speakers",
      "legacy_enable": true
    }
  ],
  "platforms": [
    "linux"
  ],
  "transport": "none",
  "lifecycle": "external",
  "host_bind_mounts": [
    {
      "host": "${XDG_RUNTIME_DIR}/pulse/native",
      "container": "/run/pulse/native",
      "readonly": true
    },
    {
      "host": "${XDG_RUNTIME_DIR}/pipewire-0",
      "container": "/run/pipewire/pipewire-0",
      "readonly": true
    },
    {
      "host": "{loophole_dir}/asound.conf",
      "container": "/etc/alsa/conf.d/50-yolo-audio-alsa.conf",
      "readonly": true
    }
  ],
  "host_devices": [
    "/dev/snd"
  ]
}
